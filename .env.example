# ============================================================================
# TAG Club Website — YouTube Configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.
# ============================================================================

# YouTube Playlist ID for the Clips & Highlights page
# Get it from: https://www.youtube.com/playlist?list=PLxxxx
# Example: NEXT_PUBLIC_YOUTUBE_CLIPS_PLAYLIST_ID=PL1234567890abcdef
NEXT_PUBLIC_YOUTUBE_CLIPS_PLAYLIST_ID=

# Optional: A single featured / "Play of the Week" YouTube video ID (11 chars)
# Leave empty to use the playlist embed only.
NEXT_PUBLIC_YOUTUBE_FEATURED_VIDEO_ID=

# Official TAG Club YouTube channel URL
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@TAGClubVIT

# Optional: YouTube Data API v3 key (for future automated playlist sync)
# Generate at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_YOUTUBE_API_KEY=
